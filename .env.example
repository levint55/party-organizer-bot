DISCORD_TOKEN=your-bot-token
DISCORD_CLIENT_ID=your-application-id
# Optional. If set, slash commands register to this server immediately.
# Leave empty to register globally (can take up to an hour).
DISCORD_GUILD_ID=
FIREBASE_PROJECT_ID=your-firebase-project-id
# Local development: path to the Firebase service account JSON key. Do not commit that file.
FIREBASE_SERVICE_ACCOUNT=C:\path\to\service-account.json
# Cloudflare: paste the same JSON into the FIREBASE_SERVICE_ACCOUNT_JSON secret instead of a file path.
