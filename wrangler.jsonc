{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "party-organizer-bot",
  "main": "cloudflare/index.ts",
  "compatibility_date": "2026-10-05",
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "containers": [
    {
      "class_name": "BotContainer",
      "image": "./Dockerfile",
      "max_instances": 1,
      "instance_type": "basic"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "BOT_CONTAINER",
        "class_name": "BotContainer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["BotContainer"]
    }
  ]
}
